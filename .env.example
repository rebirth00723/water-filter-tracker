# 全部都是選填。沒有任何必填的環境變數 —— 首次啟動開網頁完成初始化即可，
# 站台專屬設定（對外網址、ntfy 連線）也都能在「設定 → 管理」頁面填。
#
# 環境變數優先：有設的項目在管理頁面會顯示為唯讀並標示「由環境變數控制」。

# ---------- 對外 ----------
# 對外網址。啟用 passkey 時必填，且必須是「帶網域名稱的 https」
#（RP ID 不接受 IP，WebAuthn 也只在安全內容下存在 —— 這是瀏覽器的要求）。
# 不啟用 passkey 時，只有需要對外連結（設備 QR Code）才要填。
PUBLIC_URL=

# 唯一的對外埠
PORT=8085

# 把整個 App 掛在子路徑下，用於同網域上路徑撞名（如 /water）。
# 設了它，PUBLIC_URL 也要含相同前綴，否則 passkey 的來源比對與 QR 連結都會錯。
BASE_PATH=

# ---------- 登入 ----------
# 救援用臨時密碼：改了密碼又忘記時用它登入，登入後會強制要求設定新密碼。
# ⚠️ 只要留在這裡就持續有效，等同永久後門。用完請移除並重新啟動。
TEMP_PASSWORD=

# session 金鑰（簽署登入通行證的印章）。留空則首次啟動自動產生於 data/session.key。
# 想自己管理才填，用 `openssl rand -base64 48` 產生。
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30
# 自動產生的金鑰檔要放哪。留空＝資料庫檔的同一個目錄下的 session.key
SESSION_KEY_PATH=

# cookie 的 Secure 旗標：auto（依 X-Forwarded-Proto 判斷）/ true / false
COOKIE_SECURE=auto

# ---------- 資料 ----------
DATABASE_PATH=./data/app.sqlite3
# 進階：migration 的 .sql 放哪。改了才需要動它
MIGRATIONS_DIR=./drizzle

# ---------- ntfy 通知 ----------
# 三項留空即停用通知，App 照常運作。
# 只填 base URL，結尾不要帶 topic —— 本 App 用 ntfy 的 JSON 發布端點（POST 到根路徑）。
NTFY_URL=
# 分成兩個 topic：濾心提醒與安全事件。混在一起會讓後者被前者淹沒。
# topic 算不算密碼取決於 ntfy 伺服器設定：開放式伺服器（auth-default-access: read-write）
# 需要隨機後綴；需認證的伺服器（deny-all）不需要。
NTFY_TOPIC_FILTER=
NTFY_TOPIC_SECURITY=
# 認證擇一。建議用 token —— 外洩時可單獨撤銷，不必改整個帳號的密碼。
NTFY_TOKEN=
NTFY_USER=
NTFY_PASSWORD=

# ---------- 其他 ----------
# App 的時區，影響「今天是哪一天」、到期日推算與通知發送時刻。
# 用 IANA 名稱（Asia/Taipei、Europe/Berlin…）。留空＝跟隨系統時區；
# 容器映像已預設 Asia/Taipei。打錯字會退回系統時區並在日誌留一行，不會讓服務起不來。
TZ=Asia/Taipei
# 指定單一 header 取得訪客 IP。僅影響日誌準確度，不涉授權（授權完全由 session 決定）。
REAL_IP_HEADER=
LOG_LEVEL=info
