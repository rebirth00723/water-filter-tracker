# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files —— .env.example 要留著，README 叫使用者去看它
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 開發時的工作計畫，含私人基礎設施細節（網域、內網位址、主機名稱），
# 刻意不進公開 repo
/PLAN.md

# --- 本專案 ---
# 機密：ntfy 的 token 或密碼（NTFY_PASSWORD_FILE 指向的檔案）放在這裡
/secrets/
*.secret

# 資料。session.key 也在 /data/ 底下 —— 那把金鑰簽署所有登入通行證，
# 進了 repo 等於任何人都能偽造 session
/data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
